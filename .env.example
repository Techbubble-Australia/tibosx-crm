# Monorepo — combined local development
#
# Option A: copy this file to .env at the repo root and run tools that load it.
# Option B: use per-package examples (recommended for clarity):
#   - packages/api/.env.example
#   - packages/database/.env.example
#   - apps/web/.env.example
#   - apps/admin/.env.example
#
# Production: set variables on each deployed service (API needs DATABASE_URL;
# web/admin need API_URL only).

# --- Database (API + Prisma CLI) ---
DATABASE_URL="postgresql://postgres:YncZWjLXVTLnXZxzdutrDbcaiASKoCvq@shortline.proxy.rlwy.net:28481/railway"

# --- API (packages/api) ---
PORT=3001
ADMIN_EMAIL="admin@techbubble.com"
ADMIN_PASSWORD="admin123"
JWT_SECRET="your-secret-key-change-in-production"
UPLOAD_DIR="./uploads"
# Object storage (Railway Bucket / S3-compatible): see packages/api/.env.example — set OBJECT_STORAGE_* on the API service to use the bucket; omit for local disk via UPLOAD_DIR.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"

# --- Next.js apps (apps/web, apps/admin) — set API_URL in each app’s .env.local ---
API_URL="http://localhost:3001"
# apps/admin/.env.local: JWT_SECRET must match the API JWT_SECRET (middleware verifies the session cookie).
# NEXT_PUBLIC_API_URL="http://localhost:3001"
