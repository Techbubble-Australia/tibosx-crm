# Combined local development environment.
# For per-service deployments, use:
# - apps/web/.env.example
# - apps/admin/.env.example
# - packages/api/.env.example

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techbubble"

# Frontend to API communication
API_URL="http://localhost:3001"

# API Configuration
PORT=3001
ADMIN_EMAIL="admin@techbubble.com"
ADMIN_PASSWORD="admin123"
JWT_SECRET="your-secret-key-change-in-production"
UPLOAD_DIR="./uploads"
UPLOAD_URL="http://localhost:3001/uploads"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"

