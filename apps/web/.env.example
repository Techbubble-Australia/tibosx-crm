# apps/web (Next.js marketing site)
#
# Local: copy to .env.local (Next loads .env.local automatically).
# Production: set these on your host (Vercel, Railway, etc.).

# Express API base URL — server-side proxy (app/api/[...path]) and getServerApiBaseUrl() use this
# at runtime. Set in production (Docker/Railway) so it is not baked to localhost during build.
API_URL="http://localhost:3001"

# Optional — only if client-side code must call the API with an absolute URL.
# Prefer same-origin /api/... (rewrites) so you usually do not need this.
# NEXT_PUBLIC_API_URL="http://localhost:3001"
