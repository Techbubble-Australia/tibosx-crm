# apps/web (Next.js marketing site)
#
# Local: copy to .env.local (Next loads .env.local automatically).
# Production: set these on your host (Vercel, Railway, etc.).

# Express API base URL — server-side fetches (e.g. getCaseStudyBySlug) use this at runtime.
API_URL="http://localhost:3001"

# Browser-reachable API origin for uploaded images (`/uploads/...`). Must match where static uploads are served.
# Used by resolveMediaUrl for case studies, team photos, etc. If unset, falls back to API_URL (fine for local).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Optional legacy note: client-side same-origin /api/... is preferred for JSON; uploads still need a host above.
