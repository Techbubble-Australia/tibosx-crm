# Server-side proxy to main TBOS API (support routes: /api/ticketing/*)
API_URL=http://127.0.0.1:3001
# Must match TBOS API JWT signing
JWT_SECRET=your-secret-key-change-in-production
TICKETING_JWT_SECRET=

# Local dev uses package.json ports (portal 3004, API 3001). On Railway do not set PORT
# to 3004 — Railway injects PORT automatically; the app must listen on that value.
