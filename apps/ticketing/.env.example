# Server-side proxy to ticketing API (Railway: public https URL of ticketing-api service)
# Local dev only — do not use :3003 in production unless API is on the same host.
TICKETING_API_URL=http://127.0.0.1:3003

# Must match ticketing-api JWT signing (same as TBOS JWT_SECRET if using SSO)
JWT_SECRET=your-secret-key-change-in-production
TICKETING_JWT_SECRET=

# Local dev uses package.json ports (portal 3004, API 3003). On Railway do not set PORT
# to 3004 — Railway injects PORT automatically; the app must listen on that value.
