# Portal chrome theme + badge: staging | development | production
# Staging branch defaults to staging (violet). Set explicitly on Railway if needed.
# NEXT_PUBLIC_APP_ENV=staging

# Express API (server-side proxy at runtime)
API_URL=http://127.0.0.1:3001

# Public API URL (optional at Docker build — direct API URLs for uploads when same-origin proxy is not used)
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app

# Runtime: API_URL proxies /api/* and /uploads/* to the Express API (required on Railway).

# Must match packages/api JWT_SECRET
JWT_SECRET=your-secret-key-change-in-production

# Public URL users open in the browser (fixes redirects off 0.0.0.0:8080 on Railway).
# Also used by the API agent export for screenshot.publicUrl when set on the API service.
# DEBUG_PORTAL_PUBLIC_URL=https://debug-web-development.up.railway.app
# NEXT_PUBLIC_DEBUG_PORTAL_URL=https://debug-web-development.up.railway.app

# --- Railway service variables (debug-web / debug-portal service) ---
# Required when Config-as-code does not pick railway.debug-portal.toml:
# RAILWAY_DOCKERFILE_PATH=Dockerfile.debug-portal
#
# Deploy → Start command (service Settings):
#   node apps/debug-portal/server.js
#
# Other services use the same pattern, e.g.:
#   API:   RAILWAY_DOCKERFILE_PATH=Dockerfile.api
#   Web:   RAILWAY_DOCKERFILE_PATH=Dockerfile.web
#   Admin: RAILWAY_DOCKERFILE_PATH=Dockerfile.admin
