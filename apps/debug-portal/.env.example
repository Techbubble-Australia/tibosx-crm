# Express API (server-side proxy at runtime)
API_URL=http://127.0.0.1:3001

# Public API URL (inlined at Docker build for screenshot previews)
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app

# Must match packages/api JWT_SECRET
JWT_SECRET=your-secret-key-change-in-production

# --- Railway service variables (debug-web / debug-portal service) ---
# Required when Config-as-code does not pick railway.debug-portal.toml:
# RAILWAY_DOCKERFILE_PATH=Dockerfile.debug-portal
#
# Deploy → Start command (service Settings):
#   node apps/debug-portal/server.js
#
# Other services use the same pattern, e.g.:
#   API:   RAILWAY_DOCKERFILE_PATH=Dockerfile.api
#   Web:   RAILWAY_DOCKERFILE_PATH=Dockerfile.web
#   Admin: RAILWAY_DOCKERFILE_PATH=Dockerfile.admin
