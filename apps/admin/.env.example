# apps/admin (Next.js admin panel)
#
# Local: copy to .env.local
# Production: set on your admin deployment.

# Express API base URL — server-side proxies forward `/api/*` and `/uploads/*` here at runtime.
# Required in production (Docker/Railway). Case study image previews use `/uploads/...` on the admin origin
# (Next proxy) unless `NEXT_PUBLIC_API_URL` is set at build time (see below).
# Do not set DATABASE_URL here; the admin app talks to the API only.
API_URL="http://localhost:3001"

# Public TBOS admin URL (password reset emails, user invites). API uses this when building links.
# ADMIN_PUBLIC_URL="https://tibosx.ai.techbubble.net.au"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"

# Public API base (https://…) — set at Docker **build** time so `<img>` previews load uploads from the API host.
# Use the same public URL visitors could open (Railway: pass as build ARG / service variable so `next build` inlines it).
# Optional locally; required on Railway if same-origin `/uploads` proxy is unreliable or the API uses object storage.
# NEXT_PUBLIC_API_URL="https://your-api.up.railway.app"

# Must match packages/api JWT_SECRET (middleware verifies the session cookie).
JWT_SECRET="your-secret-key-change-in-production"

# Marketing site origin (Case Studies “View” opens this host + /case-studies/:slug).
# Must match where `pnpm dev` runs the web app (default Next port is 3000; admin uses 3002).
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# Client/customer support workspace lives in this app under /workspace (API: /api/admin/workspace/*).
# Set ADMIN_PUBLIC_URL on the API service so approval/notification emails link here.
