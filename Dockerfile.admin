# Dockerfile for TechBubble Admin Panel
FROM node:20-alpine AS base

# Install dependencies
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ui/package.json ./packages/ui/
COPY packages/config/package.json ./packages/config/
COPY apps/admin/package.json ./apps/admin/

# Corepack on current Node images will not download the packageManager version.
RUN npm install -g pnpm@9.15.9
RUN pnpm install --frozen-lockfile

# Build
FROM deps AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build packages
RUN pnpm --filter @techbubble/ui build

# Build the admin app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG ENV=production
ENV ENV=$ENV
ARG NEXT_PUBLIC_DEBUG_PORTAL_URL=
ENV NEXT_PUBLIC_DEBUG_PORTAL_URL=$NEXT_PUBLIC_DEBUG_PORTAL_URL
RUN pnpm --filter @techbubble/admin build

# Production
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Runtime: set ENV=development on the Railway admin service to show the dev banner (read via /api/app-env).

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static
# Standalone trace omits `public/`; without this, logos and other static files 404 in production.
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./apps/admin/public

USER nextjs

EXPOSE 3000

ENV PORT=3000

CMD ["node", "apps/admin/server.js"]
