# Loaded after repo root ../../.env when present
TICKETING_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/ticketing"

# Required on Railway: same value as packages/api and apps/admin JWT_SECRET (TBOS login cookie).
JWT_SECRET=your-secret-key-change-in-production

# Optional: portal session signing only. If unset, portal tokens use JWT_SECRET.
TICKETING_JWT_SECRET=

# Optional override for TBOS SSO verify only; defaults to JWT_SECRET.
# TBOS_JWT_SECRET=

# Local dev only. On Railway leave PORT unset — the platform sets it automatically.
TICKETING_API_PORT=3003

# Public API URL (attachment download links), e.g. https://ticketing-api-xxx.up.railway.app
# TICKETING_PUBLIC_URL=

# Disk uploads (default /app/uploads/tickets in Docker). Ignored when OBJECT_STORAGE_* is set.
# UPLOAD_DIR=/app/uploads

# Same Railway bucket / S3 vars as TBOS API (packages/api) — recommended in production.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_REGION=auto
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
