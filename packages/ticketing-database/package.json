{
  "name": "@techbubble/ticketing-database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "dotenv -e ../../.env -e .env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -e .env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -e .env -- prisma migrate deploy",
    "db:push": "dotenv -e ../../.env -e .env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -e .env -- prisma studio",
    "db:seed": "dotenv -e ../../.env -e .env -- tsx src/seed.ts"
  },
  "prisma": {
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@techbubble/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5"
  }
}
