# Required to seed the first admin (`pnpm db:seed-admin` or full `db:seed`):
# SEED_ADMIN_EMAIL="you@company.com"
# SEED_ADMIN_PASSWORD="choose-a-strong-password"
#
# Destructive seed flags (omit in production unless you intend to reset demo data):
# FORCE_SITE_CONTENT=1   — overwrites every SiteContent JSON payload with repo defaults (wipes CMS copy/uploads refs in JSON).
# FORCE_DEMO_SEED=1      — deletes home/pricing FAQs and re-seeds them; overwrites seeded job rows from definitions.
