# packages/database — Prisma CLI (migrate, seed, studio, generate)
#
# Copy to .env in this directory, or export DATABASE_URL in your shell.
# The same DATABASE_URL must be set for the running API (packages/api).
#
# Deploy migrations: pnpm db:deploy
# If a migration failed (P3018) and blocked deploy, clear the failed record then redeploy:
#   npx prisma migrate resolve --rolled-back MIGRATION_FOLDER_NAME
# (see migration.sql header in prisma/migrations for the old name if applicable)

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techbubble"

# Optional — `db:seed` uses these for the AdminUser row (defaults match packages/api/.env.example).
# ADMIN_EMAIL="admin@techbubble.com"
# ADMIN_PASSWORD="admin123"
