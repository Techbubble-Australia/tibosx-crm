generator client {
  provider      = "prisma-client-js"
  // Alpine (Docker / Railway): musl + OpenSSL 3 — avoids wrong engine and boot-time crashes
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String
  category    String   // e.g. Microsoft, ServiceNow
  subcategory String   @default("") // e.g. SharePoint, Dynamics 365
  clientName  String
  
  // Hero stats
  heroStat1Value    String
  heroStat1Label    String
  heroStat2Value    String
  heroStat2Label    String
  heroStat3Value    String
  heroStat3Label    String
  
  // Images: listing/cards use featuredImage; detail banner gallery uses bannerImages (first = hero; rest = thumbnails; empty → featured in app)
  featuredImage     String
  bannerImages      String[] @default([])
  contentImage      String   @default("")

  // Background section
  backgroundTitle   String
  backgroundContent String
  
  // Challenge section
  challengeTitle    String
  challengeContent  String
  
  // Challenge stats (the three big numbers)
  challengeStat1Value String
  challengeStat1Label String
  challengeStat2Value String
  challengeStat2Label String
  challengeStat3Value String
  challengeStat3Label String
  
  // Challenge problems (4 items)
  problem1Title     String
  problem1Content   String
  problem2Title     String
  problem2Content   String
  problem3Title     String
  problem3Content   String
  problem4Title     String
  problem4Content   String
  
  // Solution section
  solutionTitle     String
  solutionContent   String
  
  // Solution phases (3-4 phases)
  phase1Title       String
  phase1Duration    String
  phase1Content     String
  phase1Tags        String[]
  
  phase2Title       String
  phase2Duration    String
  phase2Content     String
  phase2Tags        String[]
  
  phase3Title       String
  phase3Duration    String
  phase3Content     String
  phase3Tags        String[]
  
  phase4Title       String?
  phase4Duration    String?
  phase4Content     String?
  phase4Tags        String[]
  
  // Technology Stack
  techStackTitle    String
  techStackIntro    String
  
  // Technologies (6 items)
  tech1Name         String
  tech1Description  String
  tech1Icon         String
  
  tech2Name         String
  tech2Description  String
  tech2Icon         String
  
  tech3Name         String
  tech3Description  String
  tech3Icon         String
  
  tech4Name         String
  tech4Description  String
  tech4Icon         String
  
  tech5Name         String
  tech5Description  String
  tech5Icon         String
  
  tech6Name         String
  tech6Description  String
  tech6Icon         String
  
  // Testimonial
  testimonialQuote  String
  testimonialAuthorName     String
  testimonialAuthorTitle    String
  testimonialAuthorCompany  String
  testimonialAuthorInitials String
  
  // Results section
  resultsTitle      String
  resultsContent    String
  
  // Results stats
  resultStat1Value  String
  resultStat1Label  String
  resultStat2Value  String
  resultStat2Label  String
  resultStat3Value  String
  resultStat3Label  String
  
  // Meta
  published         Boolean  @default(true)
  featured          Boolean  @default(false)
  /// When true, included in homepage / listing "All" tab; category tabs always show by category.
  showInAllTab      Boolean  @default(true)
  /// Display date on cards; falls back to createdAt when null.
  publishedDate     DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([category])
  @@index([published])
  @@index([featured])
  @@index([createdAt])
}

model ContactSubmission {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  company     String?
  interest    String?
  country     String?
  message     String
  createdAt   DateTime @default(now())
}

model CareerApplication {
  id                String            @id @default(cuid())
  firstName         String
  lastName          String
  email             String
  phone             String?
  position          String
  company           String?
  country           String?
  city              String?
  jobListingId      String?
  jobListing        JobListing?       @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  visaStatus        String?
  salaryCurrency    String?
  salaryRate        Int?
  salaryMode        String?
  salaryExpectation Int?
  resumeUrl         String?
  /// Uploaded document URLs (resume, visa copies, etc.)
  documentUrls      Json?
  message           String?
  /// Australian citizen / permanent resident (default yes on website apply form).
  isCitizen         Boolean           @default(true)
  /// Pipeline status for recruiter tracking.
  status            String            @default("INTERNAL_REVIEW")
  /// Scheduled interview date/time when status is INTERVIEW_SCHEDULED.
  interviewScheduledAt DateTime?
  /// Feedback or notes when status is SELECTED, REJECTED, or CANCELLED.
  statusComments    String?           @db.Text
  /// Rate charged to the client for this candidate placement.
  chargeRate        String            @default("")
  /// Years of relevant experience (from apply form).
  relevantExperience Int?
  profileId         String?
  candidateProfile  CandidateProfile? @relation("ProfileApplications", fields: [profileId], references: [id], onDelete: SetNull)
  legacyProfile     CandidateProfile? @relation("LegacyPrimaryApplication")
  contractId        String?           @unique
  contract          Contract?         @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@index([profileId])
}

model CandidateProfile {
  id                  String             @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  phone               String
  country             String             @default("")
  city                String?
  category            String
  technology          String
  expectedRate        Int
  currency            String
  mode                String
  documentUrls        Json
  /// Extracted plain text from uploaded resumes for search/matching.
  resumeText          String?            @db.Text
  previousSalary      Int?
  comments            String?            @db.Text
  isCitizen           Boolean            @default(true)
  visaStatus          String?
  /// Manager | Architect | Developer | Tester — aligned with job listing level.
  level               String             @default("Developer")
  /// Years of relevant experience.
  relevantExperience  Int                @default(0)
  /// Whether the candidate is available for new roles.
  available           Boolean            @default(true)
  /// Admin user who sourced this candidate (recruiter/admin).
  sourcedById         String?
  sourcedBy           AdminUser?         @relation("ProfileSourcedBy", fields: [sourcedById], references: [id], onDelete: SetNull)
  careerApplicationId String?            @unique
  careerApplication   CareerApplication? @relation("LegacyPrimaryApplication", fields: [careerApplicationId], references: [id], onDelete: SetNull)
  careerApplications  CareerApplication[] @relation("ProfileApplications")
  contractProfiles    ContractProfile[]
  projectMembers      ProjectMember[]
  mappedAdminUser     AdminUser?         @relation("AdminUserMappedProfile")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([sourcedById])
  @@index([email])
  @@index([category])
  @@index([technology])
  @@index([country])
  @@index([createdAt])
}

model CaseStudyCategory {
  id            String                 @id @default(cuid())
  name          String                 @unique
  order         Int                    @default(0)
  subcategories CaseStudySubcategory[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([order])
}

model CaseStudySubcategory {
  id         String            @id @default(cuid())
  name       String
  categoryId String
  category   CaseStudyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order      Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([order])
}

model JobCategory {
  id           String          @id @default(cuid())
  name         String          @unique
  order        Int             @default(0)
  technologies JobTechnology[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([order])
}

model JobDepartment {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model JobLevel {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model JobTechnology {
  id         String      @id @default(cuid())
  name       String
  categoryId String
  category   JobCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([order])
}

model Client {
  id            String          @id @default(cuid())
  name          String          @unique
  website       String          @default("")
  country       String
  order         Int             @default(0)
  /// ACTIVE | PROSPECT | INACTIVE
  status        String          @default("ACTIVE")
  jobs          JobListing[]
  contacts      ClientContact[]
  opportunities Opportunity[]
  contracts     Contract[]
  projects        Project[]
  workspaceGroups WorkspaceGroup[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([order])
  @@index([status])
}

model WorkspaceGroup {
  id        String   @id @default(cuid())
  name      String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members   WorkspaceGroupMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model WorkspaceGroupMember {
  id          String         @id @default(cuid())
  groupId     String
  group       WorkspaceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   AdminUser      @relation("WorkspaceGroupMember", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([groupId, adminUserId])
  @@index([adminUserId])
}

model Opportunity {
  id        String   @id @default(cuid())
  name      String
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Country / location for this opportunity.
  location  String   @default("")
  /// FIXED_PRICE | T_AND_M | SUPPORT | OTHER
  type      String   @default("FIXED_PRICE")
  contactId String?
  contact   ClientContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  currency  String
  amount    Decimal  @db.Decimal(14, 2)
  /// DRAFT | PROPOSAL | IN_PROGRESS | ACCEPTED | REJECTED
  status    String   @default("DRAFT")
  comments  String   @default("") @db.Text
  order     Int      @default(0)
  /// Whether this opportunity is still active (false = archived / no longer pursued).
  active    Boolean  @default(true)
  ownerId   String?
  owner     AdminUser? @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  jobs       JobListing[]
  timesheets       Timesheet[]
  timesheetEntries TimesheetEntry[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([clientId])
  @@index([contactId])
  @@index([status])
  @@index([order])
  @@index([active])
  @@index([ownerId])
}

model Contract {
  id             String              @id @default(cuid())
  contractNumber String              @unique
  title          String
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// FIXED_PRICE | T_AND_M | SUPPORT | OTHER
  type           String              @default("FIXED_PRICE")
  /// DRAFT | ACTIVE | EXPIRED | CANCELED
  status         String              @default("DRAFT")
  startDate      DateTime
  endDate        DateTime?
  /// HOUR | DAY — only for T&M contracts
  unit           String?
  /// Number of units — only for T&M contracts
  numberOfUnits  Decimal?            @db.Decimal(14, 4)
  currency       String
  rate           Decimal             @db.Decimal(14, 2)
  contractValue  Decimal             @db.Decimal(14, 2)
  totalVariation Decimal             @default(0) @db.Decimal(14, 2)
  consumed       Decimal             @default(0) @db.Decimal(14, 2)
  comments       String              @default("") @db.Text
  fileUrls       Json?
  ownerId        String?
  owner          AdminUser?          @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  variations      ContractVariation[]
  milestones      ContractMilestone[]
  invoices        ContractInvoice[]
  workUnitMonths  ContractWorkUnitMonth[]
  contractProfiles ContractProfile[]
  projects         Project[]
  careerApplication CareerApplication?
  activityLogs    ContractActivityLog[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([type])
  @@index([ownerId])
}

model ContractProfile {
  id         String           @id @default(cuid())
  contractId String
  contract   Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  profileId  String
  profile    CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())

  @@unique([contractId, profileId])
  @@index([contractId])
  @@index([profileId])
}

model ContractActivityLog {
  id            String     @id @default(cuid())
  contractId    String
  contract      Contract   @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// CREATED | FIELD_UPDATED | ACTIVATED | TERMINATED | MOVE_TO_DRAFT | AUTO_EXPIRED
  action        String
  fieldName     String?
  oldValue      String?    @db.Text
  newValue      String?    @db.Text
  /// INCORRECT_CONTRACT_VALUE | INCORRECT_RATE_VALUE | ERROR_IN_TYPE | OTHER
  reason        String?
  otherReason   String?    @db.Text
  performedById String?
  performedBy   AdminUser? @relation("ContractActivityPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([contractId])
  @@index([createdAt])
}

model ContractVariation {
  id               String    @id @default(cuid())
  contractId       String
  contract         Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  variationDate    DateTime
  variationEndDate DateTime?
  comments         String    @default("") @db.Text
  /// Qty for T&M variations
  qty              Decimal?          @db.Decimal(14, 4)
  /// HOUR | DAY for T&M variations (legacy)
  unit             String?
  rate             Decimal?  @db.Decimal(14, 2)
  /// Monetary value added to total variation
  variationValue   Decimal   @db.Decimal(14, 2)
  project          Project?
  createdAt        DateTime  @default(now())

  @@index([contractId])
}

model ContractWorkUnitMonth {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// "base" for the contract period, or a variation id
  segmentKey String   @default("base")
  year       Int
  /// 0–11 (Jan–Dec)
  month      Int
  workUnits  Decimal  @db.Decimal(14, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([contractId, segmentKey, year, month])
  @@index([contractId])
}

model ContractMilestone {
  id            String   @id @default(cuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  description   String
  milestoneDate DateTime
  amount        Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  @@index([contractId])
  @@index([milestoneDate])
}

model ContractInvoice {
  id            String   @id @default(cuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoiceNumber String
  reference     String   @default("")
  issueDate     DateTime
  dueDate       DateTime
  /// DRAFT | AWAITING_PAYMENT | PAID | CANCELED
  status        String   @default("DRAFT")
  currency      String   @default("AUD")
  description   String   @db.Text
  qty           Decimal  @db.Decimal(14, 4)
  rate          Decimal  @db.Decimal(14, 2)
  amount        Decimal  @db.Decimal(14, 2)
  taxRate       Decimal  @default(10) @db.Decimal(5, 2)
  taxAmount     Decimal  @db.Decimal(14, 2)
  totalAmount   Decimal  @db.Decimal(14, 2)
  fileUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contractId])
  @@index([status])
}

model ClientContact {
  id               String        @id @default(cuid())
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  email            String
  position         String?
  phoneCountryCode String
  phoneNumber      String
  order            Int           @default(0)
  opportunities    Opportunity[]
  projectLinks     ProjectClientContact[]
  mappedAdminUser     AdminUser?     @relation("AdminUserMappedContact")
  mappedCustomerUser  CustomerUser?  @relation("CustomerUserMappedContact")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([clientId])
}

model JobListing {
  id              String    @id @default(cuid())
  slug            String    @unique
  referenceNumber String    @unique
  title           String
  location        String
  country         String
  flag            String    // emoji flag (primary / first location for legacy consumers)
  /// [{ countryCode, country, flag, label?, cities? }] — multi-country roles; when set, drives public display.
  locations       Json?
  type            String    // full-time | contract | part-time (employment type)
  /// Internal | External for Client — admin-only; never exposed on the public site
  listingType     String    @default("Internal")
  workMode        String    // remote | hybrid | onsite
  category        String
  technology      String
  department      String
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  description     String    @default("") @db.Text
  likeCount       Int       @default(0)
  published       Boolean   @default(true)
  /// Date shown on admin records; set automatically on create.
  publishedDate   DateTime?
  isHot           Boolean   @default(false)
  /// Manager | Architect | Developer | Tester
  level           String    @default("Developer")
  /// Number of open positions for this role.
  positionsCount  Int       @default(1)
  /// Primary city for admin list display (Any / Other / named city).
  city            String?
  /// Optional end-client name (free text).
  endClient       String?
  /// Admin budget notes (free text).
  budget          String    @default("")
  /// Recruiter-defined tags for AI profile matching (e.g. AWS, Python).
  metaTags        String[]  @default([])
  order           Int       @default(0)
  /// Admin user IDs assigned as recruiters for this role
  recruiterIds    Json?
  likes           JobLike[]
  applications    CareerApplication[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published])
  @@index([order])
  @@index([category])
  @@index([technology])
  @@index([department])
  @@index([clientId])
  @@index([opportunityId])
}

model JobLike {
  id         String     @id @default(cuid())
  jobId      String
  job        JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  visitorKey String
  createdAt  DateTime   @default(now())

  @@unique([jobId, visitorKey])
  @@index([jobId])
}

model TeamMember {
  id                       String   @id @default(cuid())
  name                     String
  role                     String
  location                 String   @default("")
  department               String   // e.g. Management Team, ServiceNow Developers, etc.
  description              String   @default("")
  imageUrl                 String   @default("")
  order                    Int      @default(0)
  published                Boolean  @default(true)
  /// 1–3 = "Meet the Leadership" slot on About (public site). At most one row per value; null = not featured.
  featuredLeadershipOrder  Int?     @unique
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([department])
  @@index([published])
  @@index([order])
}

model Testimonial {
  id                  String   @id @default(cuid())
  quote               String
  authorName          String
  authorTitle         String
  authorCompany       String
  authorInitials      String
  authorImageUrl      String   @default("")
  order               Int      @default(0)
  published           Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([published])
  @@index([order])
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String   @default("general") // pricing | general | technical | home
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([order])
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String   @default("")
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model CredentialTemplate {
  id               String          @id @default(cuid())
  name             String          @unique
  html             String          @db.Text
  /// JSON: [{ key, label, type, options?, required }]
  variables        Json
  addStartDate     Boolean         @default(true)
  requireStartDate Boolean         @default(true)
  addEndDate       Boolean         @default(true)
  requireEndDate   Boolean         @default(true)
  members                    ProjectMember[]
  adminUserCredentialAssignments AdminUserCredentialAssignment[]
  agreementRecords           AdminUserAgreementRecord[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model EmailNotificationPreference {
  id             String   @id @default(cuid())
  notificationId String
  role           String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([notificationId, role])
  @@index([notificationId])
}

model AdminUserCredentialAssignment {
  id                   String             @id @default(cuid())
  adminUserId          String             @unique
  adminUser            AdminUser          @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  credentialTemplateId String
  credentialTemplate   CredentialTemplate @relation(fields: [credentialTemplateId], references: [id], onDelete: Restrict)
  credentialData       Json?
  agreementSignedAt    DateTime?
  signatureDataUrl     String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Project {
  id               String              @id @default(cuid())
  projectNumber    String              @unique
  title            String
  description      String              @db.Text
  clientId         String
  client           Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// DELIVERY | SUPPORT
  kind             String              @default("DELIVERY")
  /// DRAFT | ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  status           String              @default("DRAFT")
  projectManagerId String
  projectManager   AdminUser           @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  timesheetApproverUserId String
  timesheetApprover       AdminUser    @relation("ProjectTimesheetApprover", fields: [timesheetApproverUserId], references: [id], onDelete: Restrict)
  contractId           String?
  contract             Contract?           @relation(fields: [contractId], references: [id], onDelete: SetNull)
  contractVariationId  String?             @unique
  contractVariation    ContractVariation?  @relation(fields: [contractVariationId], references: [id], onDelete: SetNull)
  startDate            DateTime
  endDate          DateTime
  /// Support ticket number prefix (e.g. TKT). Used when kind is SUPPORT.
  ticketPrefix         String              @default("TKT")
  /// Zero-padded sequence width for support ticket numbers.
  ticketNumberDigits   Int                 @default(5)
  /// Contract value (or variation value) when created from a contract; editable afterwards.
  budget               Decimal?            @db.Decimal(14, 2)
  budgetCurrency       String?
  fileUrls         Json?
  members          ProjectMember[]
  estimates        ProjectEstimate[]
  actuals          ProjectActual[]
  timesheets       Timesheet[]
  activityLogs        ProjectActivityLog[]
  supportOrganization Organization?
  clientContacts      ProjectClientContact[]
  supportGroup        ProjectSupportGroup?
  tickets             Ticket[]
  agreementRecords    AdminUserAgreementRecord[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([kind])
  @@index([projectManagerId])
  @@index([contractId])
}

model ProjectClientContact {
  id                   String        @id @default(cuid())
  projectId            String
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contactId            String
  contact              ClientContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  portalAccess         Boolean       @default(true)
  canApproveTimesheets Boolean       @default(false)
  /// One portal login can be the client contact on several projects.
  ticketingUserId      String?
  ticketingUser        TicketingUser? @relation("ProjectClientPortalUser", fields: [ticketingUserId], references: [id], onDelete: SetNull)
  timesheetApprovals   Timesheet[]   @relation("TimesheetClientApprover")
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([projectId, contactId])
  @@index([projectId])
  @@index([contactId])
  @@index([ticketingUserId])
}

model ProjectSupportGroup {
  id        String                    @id @default(cuid())
  projectId String                    @unique
  project   Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String                    @default("Support team")
  members   ProjectSupportGroupMember[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
}

model ProjectSupportGroupMember {
  id              String             @id @default(cuid())
  groupId         String
  group           ProjectSupportGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  projectMemberId String?            @unique
  projectMember   ProjectMember?     @relation(fields: [projectMemberId], references: [id], onDelete: SetNull)
  adminUserId     String?
  adminUser       AdminUser?         @relation("SupportGroupMember", fields: [adminUserId], references: [id], onDelete: SetNull)
  ticketingUserId String?
  ticketingUser   TicketingUser?     @relation("SupportGroupConsultant", fields: [ticketingUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())

  @@unique([groupId, ticketingUserId])
  @@index([groupId])
  @@index([adminUserId])
  @@index([ticketingUserId])
}

model ProjectMember {
  id                   String              @id @default(cuid())
  projectId            String
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  profileId            String
  profile              CandidateProfile    @relation(fields: [profileId], references: [id], onDelete: Restrict)
  adminUserId          String?
  adminUser            AdminUser?          @relation("ProjectMemberUser", fields: [adminUserId], references: [id], onDelete: SetNull)
  credentialTemplateId String?
  credentialTemplate   CredentialTemplate? @relation(fields: [credentialTemplateId], references: [id], onDelete: SetNull)
  credentialData       Json?
  signatureDataUrl     String?             @db.Text
  agreementSignedAt    DateTime?
  rateCurrency         String              @default("AUD")
  rate                 Decimal?            @db.Decimal(14, 2)
  /// HOURLY | DAILY | WEEKLY | FORTNIGHTLY | MONTHLY
  rateFrequency        String              @default("DAILY")
  supportGroupMember   ProjectSupportGroupMember?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([projectId, profileId])
  @@index([projectId])
  @@index([profileId])
  @@index([adminUserId])
}

model ProjectEstimate {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year          Int
  month         Int
  qty           Decimal  @db.Decimal(14, 4)
  currency      String
  estimatedCost Decimal  @db.Decimal(14, 2)
  /// personnel | one-time | other
  costType      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

model ProjectActual {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  qty         Decimal  @db.Decimal(14, 4)
  currency    String
  actualCost  Decimal  @db.Decimal(14, 2)
  costType    String
  /// manual | timesheet — timesheet rows are rebuilt from approved timesheets × member rates
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model ProjectActivityLog {
  id            String     @id @default(cuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action        String
  fieldName     String?
  oldValue      String?    @db.Text
  newValue      String?    @db.Text
  reason        String?    @db.Text
  performedById String?
  performedBy   AdminUser? @relation("ProjectActivityPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model Timesheet {
  id                     String                @id @default(cuid())
  projectId              String?
  project                Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  opportunityId          String?
  opportunity            Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  ticketId               String?
  ticket                 Ticket?               @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  memberUserId           String
  memberUser             AdminUser             @relation("TimesheetMember", fields: [memberUserId], references: [id], onDelete: Restrict)
  startDate              DateTime
  endDate                DateTime
  /// MONTHLY (hours keyed by ISO date, startDate = 1st of month). WEEKLY marks legacy rows awaiting conversion.
  period                 String                @default("MONTHLY")
  /// MONTHLY only: ISO dates marked as a day off (leave / public holiday).
  daysOff                Json?
  /// DRAFT | SUBMITTED | APPROVED
  status                 String                @default("DRAFT")
  /// PM | CLIENT_CONTACT
  approverKind           String?
  projectClientContactId String?
  projectClientContact   ProjectClientContact? @relation("TimesheetClientApprover", fields: [projectClientContactId], references: [id], onDelete: SetNull)
  fileUrls               Json?
  /// Hours per weekday for the selected week (mon–sun).
  dailyHours             Json?
  /// Optional note per weekday (mon–sun).
  dailyComments          Json?
  rejectReason           String?               @db.Text
  comments               String?               @db.Text
  activityLogs           TimesheetActivityLog[]
  entries                TimesheetEntry[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([projectId])
  @@index([opportunityId])
  @@index([ticketId])
  @@index([memberUserId])
  @@index([status])
  @@index([projectClientContactId])
}

model TimesheetActivityLog {
  id            String     @id @default(cuid())
  timesheetId   String
  timesheet     Timesheet  @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  action        String
  reason        String?    @db.Text
  performedById String?
  performedBy   AdminUser? @relation("TimesheetActivityPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([timesheetId])
  @@index([createdAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String
  role         String   @default("admin")
  /// Extra TBOS roles (union with `role` for permissions and navigation).
  additionalRoles Json?
  profilePhotoUrl String?
  active       Boolean  @default(true)
  /// AES-256-GCM encrypted TOTP secret (set during MFA enrollment).
  totpSecretEnc String?
  mfaEnabled    Boolean  @default(false)
  mfaEnrolledAt DateTime?
  passwordNeedsReset Boolean @default(false)
  /// SHA-256 hash of one-time email password reset token.
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  /// CRM client contact linked when this user has the Client role.
  mappedClientContactId String?       @unique
  mappedClientContact   ClientContact? @relation("AdminUserMappedContact", fields: [mappedClientContactId], references: [id], onDelete: SetNull)
  /// Recruitment profile linked for project member access.
  mappedProfileId       String?            @unique
  mappedProfile         CandidateProfile?  @relation("AdminUserMappedProfile", fields: [mappedProfileId], references: [id], onDelete: SetNull)
  addressLine1  String?
  addressLine2  String?
  suburb        String?
  city          String?
  state         String?
  postcode      String?
  country       String?
  profileDetailsCompletedAt DateTime?
  /// When true, user must complete consultant KYC (bank, address, proofs) after first login.
  requireProfileAfterFirstLogin Boolean @default(true)
  /// INCOMPLETE | COMPLETE — consultant profile / KYC on the internal user record.
  profileKycStatus            String  @default("INCOMPLETE")
  /// Incremented when the user is invited to TBOS (credentials email).
  inviteCount Int @default(0)
  /// Legacy; superseded by requireProfileAfterFirstLogin + profileKycStatus.
  profileOnboardingRequiredAt DateTime?
  agreementDocumentUrl      String?  @db.Text
  bankDetails               Json?
  idProofUrl                String?  @db.Text
  addressProofUrl           String?  @db.Text
  userFiles                 Json?
  emergencyContacts         Json?
  taxNumber                 String?
  sourcedProfiles CandidateProfile[] @relation("ProfileSourcedBy")
  ownedContracts Contract[] @relation("ContractOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  contractActivities ContractActivityLog[] @relation("ContractActivityPerformer")
  managedProjects Project[] @relation("ProjectManager")
  timesheetApproverProjects Project[] @relation("ProjectTimesheetApprover")
  projectMemberships ProjectMember[] @relation("ProjectMemberUser")
  timesheets Timesheet[] @relation("TimesheetMember")
  projectActivities ProjectActivityLog[] @relation("ProjectActivityPerformer")
  timesheetActivities TimesheetActivityLog[] @relation("TimesheetActivityPerformer")
  activityLogs        AdminUserActivityLog[] @relation("AdminUserActivitySubject")
  performedUserLogs   AdminUserActivityLog[] @relation("AdminUserActivityPerformer")
  ticketingUser       TicketingUser?         @relation("TicketingTbosUser")
  supportGroupMemberships ProjectSupportGroupMember[] @relation("SupportGroupMember")
  workspaceGroupMemberships WorkspaceGroupMember[]      @relation("WorkspaceGroupMember")
  credentialAssignment    AdminUserCredentialAssignment?
  agreementRecords        AdminUserAgreementRecord[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Client portal accounts (separate from internal AdminUser records).
model CustomerUser {
  id                     String         @id @default(cuid())
  email                  String         @unique
  name                   String?
  phone                  String?
  passwordHash           String
  active                 Boolean        @default(true)
  profilePhotoUrl        String?
  mfaEnabled             Boolean        @default(true)
  mfaEnrolledAt          DateTime?
  totpSecretEnc          String?
  passwordNeedsReset     Boolean        @default(false)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  mappedClientContactId  String?        @unique
  mappedClientContact    ClientContact? @relation("CustomerUserMappedContact", fields: [mappedClientContactId], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}

model AdminUserAgreementRecord {
  id                   String             @id @default(cuid())
  adminUserId          String
  adminUser            AdminUser          @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  credentialTemplateId String
  credentialTemplate   CredentialTemplate @relation(fields: [credentialTemplateId], references: [id], onDelete: Restrict)
  templateName         String
  projectId            String?
  project              Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectMemberId      String?
  startDate            DateTime?
  endDate              DateTime?
  assignedAt           DateTime           @default(now())
  agreementSignedAt    DateTime?
  agreementDocumentUrl String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([adminUserId])
  @@index([projectMemberId])
}

model AdminUserActivityLog {
  id            String     @id @default(cuid())
  adminUserId   String
  adminUser     AdminUser  @relation("AdminUserActivitySubject", fields: [adminUserId], references: [id], onDelete: Cascade)
  action        String
  fieldName     String?
  oldValue      String?    @db.Text
  newValue      String?    @db.Text
  performedById String?
  performedBy   AdminUser? @relation("AdminUserActivityPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@index([adminUserId])
  @@index([createdAt])
}

// --- Client support ticketing (portal) ---

enum TicketingUserRole {
  CLIENT
  CONSULTANT
}

enum TicketType {
  TECHNICAL
  FINANCIAL_LOAN
  SERVICE_INTERNAL
  SERVICE_EXTERNAL
  BUG
  ENHANCEMENT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  PENDING_CLIENT
  RESOLVED
  CLOSED
  CANCELLED
}

/// Support portal tenant; optionally linked to TBOS delivery Project.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  projectId String?  @unique
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                     TicketingUser[]
  tickets                   Ticket[]
  consultantOrganizations   ConsultantOrganization[]
}

model TicketingUser {
  id                 String            @id @default(cuid())
  email              String            @unique
  passwordHash       String
  name               String
  profilePhotoUrl    String?
  role               TicketingUserRole
  organizationId     String?
  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  consultantVerified Boolean           @default(false)
  tbosAdminUserId    String?           @unique
  tbosAdminUser      AdminUser?        @relation("TicketingTbosUser", fields: [tbosAdminUserId], references: [id], onDelete: SetNull)
  tbosRole           String?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  createdTickets          Ticket[]                 @relation("TicketCreatedBy")
  assignedTickets         Ticket[]                 @relation("TicketAssignedTo")
  updatedTickets          Ticket[]                 @relation("TicketUpdatedBy")
  messages                TicketMessage[]
  auditLogs               TicketAuditLog[]         @relation("AuditActor")
  consultantOrganizations ConsultantOrganization[]
  projectClientLinks      ProjectClientContact[]   @relation("ProjectClientPortalUser")
  supportGroupMembers     ProjectSupportGroupMember[] @relation("SupportGroupConsultant")

  @@index([organizationId])
  @@index([role])
}

model ConsultantOrganization {
  id             String        @id @default(cuid())
  consultantId   String
  consultant     TicketingUser @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([consultantId, organizationId])
  @@index([consultantId])
  @@index([organizationId])
}

model Ticket {
  id             String         @id @default(cuid())
  ticketNumber   String
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type           TicketType
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  subject        String
  description    String         @db.Text
  createdById    String
  createdBy      TicketingUser  @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedToId   String?
  assignedTo     TicketingUser? @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  updatedById    String?
  updatedBy      TicketingUser? @relation("TicketUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  closedAt         DateTime?
  resolutionNotes  String?        @db.Text
  /// Initial estimated effort (hours) set while in progress.
  estimatedEffortHours Decimal?   @db.Decimal(8, 2)
  effortAnalysis       Decimal?   @db.Decimal(8, 2)
  effortBuild          Decimal?   @db.Decimal(8, 2)
  effortTest           Decimal?   @db.Decimal(8, 2)
  effortDocument       Decimal?   @db.Decimal(8, 2)
  effortSupport        Decimal?   @db.Decimal(8, 2)

  messages    TicketMessage[]
  attachments TicketAttachment[]
  auditLogs   TicketAuditLog[]
  timesheets       Timesheet[]
  timesheetEntries TimesheetEntry[]

  @@unique([projectId, ticketNumber])
  @@index([organizationId, status])
  @@index([projectId])
  @@index([createdAt])
}

model TimesheetEntry {
  id             String       @id @default(cuid())
  timesheetId    String
  timesheet      Timesheet    @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Restrict)
  ticketId       String?
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  dailyHours     Json?
  dailyComments  Json?
  billable       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([timesheetId])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     TicketingUser @relation(fields: [authorId], references: [id])
  body       String        @db.Text
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  storageKey   String?
  fileSize     Int?
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

model TicketAuditLog {
  id        String         @id @default(cuid())
  ticketId  String
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     TicketingUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  field     String?
  oldValue  String?        @db.Text
  newValue  String?        @db.Text
  metadata  Json?
  createdAt DateTime       @default(now())

  @@index([ticketId, createdAt])
}

enum DebugCaptureTicketType {
  BUG
  ENHANCEMENT
}

enum DebugReportedEnvironment {
  development
  staging
  production
}

/// A sprint groups debug tickets into its own board.
model DebugSprint {
  id        String               @id @default(cuid())
  name      String
  goal      String?              @db.Text
  startDate DateTime?
  endDate   DateTime?
  /// PLANNED | ACTIVE | COMPLETED
  status    String               @default("PLANNED")
  tickets   DebugCaptureTicket[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
}

/// Board columns for debug tickets. System statuses can be renamed/recoloured but not deleted.
model DebugTicketStatus {
  id        String   @id @default(cuid())
  /// Stable value stored on tickets (e.g. PENDING, BLOCKED).
  key       String   @unique
  label     String
  /// Palette name used by the debug portal (amber, sky, violet, emerald, rose, …).
  color     String   @default("slate")
  position  Int
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model DebugCaptureTicket {
  id                   String                   @id @default(cuid())
  ticketId             String                   @unique
  type                 DebugCaptureTicketType
  /// Key of a DebugTicketStatus row.
  status               String                   @default("PENDING")
  /// Null = backlog (not planned into a sprint).
  sprintId             String?
  sprint               DebugSprint?             @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  reportedEnvironment  DebugReportedEnvironment @default(development)
  userDescription      String                   @db.Text
  reporterUserId       String
  reporterEmail        String
  reporterRole         String
  currentUrl           String                   @db.Text
  userAgent            String                   @db.Text
  elementDiagnostics   Json
  apiPrerequisite      Json?
  /// First screenshot (kept for older readers); `screenshotUrls` holds every attachment.
  screenshotUrl        String?
  screenshotUrls       String[]                 @default([])
  fullPayload          Json
  logs                 DebugCaptureTicketLog[]
  comments             DebugCaptureTicketComment[]
  createdAt            DateTime                 @default(now())

  @@index([createdAt])
  @@index([reporterUserId])
  @@index([status])
  @@index([sprintId])
}

/// Discussion on a debug ticket; anyone who can open the ticket can read and post.
model DebugCaptureTicketComment {
  id           String             @id @default(cuid())
  ticketId     String
  ticket       DebugCaptureTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String
  authorEmail  String
  authorName   String?
  body         String             @db.Text
  /// [{ url, name, kind: "image" | "file", size? }]
  attachments  Json?
  /// Set when the author edits the comment.
  editedAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([ticketId, createdAt])
}

/// Who changed what on a debug ticket (portal edits, status moves, AI agent updates).
model DebugCaptureTicketLog {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      DebugCaptureTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// CREATED | STATUS_CHANGED | UPDATED | SCREENSHOTS_ADDED | SCREENSHOT_REMOVED | COMMENT_ADDED | COMMENT_EDITED | COMMENT_DELETED
  action      String
  field       String?
  oldValue    String?            @db.Text
  newValue    String?            @db.Text
  actorUserId String?
  actorEmail  String
  createdAt   DateTime           @default(now())

  @@index([ticketId, createdAt])
}
