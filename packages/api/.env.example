# packages/api (Express + Prisma)
#
# Local: copy to .env next to this file or load from monorepo root.
# Production: set all secrets in the host (Railway, etc.) — never commit real values.

# PostgreSQL — required. Prisma schema uses this variable.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techbubble"

# HTTP
PORT=3001

# Admin users: `pnpm --filter @techbubble/database db:seed` upserts AdminUser with bcrypt using these values.
ADMIN_EMAIL="admin@techbubble.com"
ADMIN_PASSWORD="admin123"

# JWT for /api/admin/* — use a long random string in production
JWT_SECRET="your-secret-key-change-in-production"

# Optional: HMAC secret for draft case study preview links (?preview=… on the marketing site).
# If unset in non-production, JWT_SECRET is used so local preview works without extra config.
# CASE_STUDY_PREVIEW_SECRET="long-random-string-for-preview-links"

# File uploads (authenticated routes). Files are served at GET {API_ORIGIN}/uploads/<filename>.
UPLOAD_DIR="./uploads"
# Optional legacy: upload responses use portable paths `/uploads/<file>`. Apps rewrite using NEXT_PUBLIC_API_URL (web) or NEXT_PUBLIC_API_URL (admin preview).
# UPLOAD_URL is no longer appended to responses; keep only if other tooling references it.

# CORS — comma-separated origins for browser-direct API calls (optional if all traffic is same-origin via Next proxies).
# Include production HTTPS URLs for web + admin when needed, plus local dev:
# ALLOWED_ORIGINS="https://your-web.up.railway.app,https://your-admin.up.railway.app,http://localhost:3000,http://localhost:3002"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"
