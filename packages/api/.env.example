# packages/api (Express + Prisma)
#
# Local: copy to .env next to this file or load from monorepo root.
# Production: set all secrets in the host (Railway, etc.) — never commit real values.

# Optional: development | production (admin app uses this for the dev banner; API may use later)
# ENV="development"

# PostgreSQL — required. Prisma schema uses this variable.
DATABASE_URL="postgresql://postgres:YncZWjLXVTLnXZxzdutrDbcaiASKoCvq@shortline.proxy.rlwy.net:28481/railway"

# HTTP
PORT=3001

# Initial admin: set SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD in packages/database/.env and run
# `pnpm --filter @techbubble/database db:seed-admin` (not on API startup).

# JWT for /api/admin/* — use a long random string in production
JWT_SECRET="your-secret-key-change-in-production"

# Optional: separate key for encrypting MFA TOTP secrets at rest (32+ chars recommended).
# Falls back to JWT_SECRET when unset.
# MFA_ENCRYPTION_KEY="long-random-string-for-mfa-encryption"

# Label shown in authenticator apps when enrolling MFA (otpauth issuer).
# Default: TIBOSX.AI. When ENV or TBOS_ENV is development and this is unset, default is DEV.TIBOSX.AI.
# MFA_ISSUER_NAME="TIBOSX.AI"
# MFA_ISSUER_NAME="DEV.TIBOSX.AI"

# Optional: HMAC secret for draft case study preview links (?preview=… on the marketing site).
# If unset in non-production, JWT_SECRET is used so local preview works without extra config.
# CASE_STUDY_PREVIEW_SECRET="long-random-string-for-preview-links"

# File uploads (authenticated POST /api/upload/*). Responses use portable paths `/uploads/<file>`;
# web and admin proxy GET `/uploads/...` to this API.

# --- Option A: S3-compatible bucket (Railway Bucket / Tigris / MinIO, etc.) ---
# When all OBJECT_STORAGE_* variables below are set, uploads are stored in the bucket and
# served via GET /uploads/... from object storage. Omit them to use local disk instead.
# The bucket may stay private: the API reads objects with these credentials (s3:GetObject + s3:PutObject).
# If previews return 403, widen the access key policy or bucket policy for GetObject on `uploads/*`.
# OBJECT_STORAGE_ENDPOINT="https://t3.storageapi.dev"
# OBJECT_STORAGE_REGION="auto"
# OBJECT_STORAGE_BUCKET="your-bucket-name"
# OBJECT_STORAGE_ACCESS_KEY_ID="your-access-key"
# OBJECT_STORAGE_SECRET_ACCESS_KEY="your-secret-key"
# Path-style URLs (default true). Set to false if your provider requires virtual-hosted-style.
# OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# --- Option B: local disk (default when object storage is not configured) ---
UPLOAD_DIR="./uploads"

# CORS — comma-separated origins for browser-direct API calls (optional if all traffic is same-origin via Next proxies).
# Include production HTTPS URLs for web + admin when needed, plus local dev:
# ALLOWED_ORIGINS="https://techbubble.net.au,https://tibosx.ai.techbubble.net.au,http://localhost:3000,http://localhost:3002"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3002"

# Public TBOS admin URL (user invite + password reset links in email).
# ADMIN_PUBLIC_URL="https://tibosx.ai.techbubble.net.au"

# --- Email gateway (Resend): ticket notifications, user invites, password reset, careers ---
# Without RESEND_API_KEY, transactional emails are logged only (not sent).
# RESEND_API_KEY="re_xxxxxxxx"
# From address must use a domain verified at https://resend.com/domains
# MAIL_FROM="TechBubble <noreply@techbubble.net.au>"
# TBOS-only (invites, password reset). If unset, defaults to noreply@techbubble.net.au
# TBOS_MAIL_FROM="TIBOSX <noreply@techbubble.net.au>"
# CAREERS_HR_EMAIL="hr@techbubble.com.au"
# CONTACT_NOTIFICATION_EMAIL="sales@techbubble.com.au"
# PUBLIC_WEB_URL="https://techbubble.com.au"

# --- Debug portal agent API (dev only, no auth — blocked when ENV is not development) ---
# GET  /api/debug-portal/agent/tickets/in-progress
# PATCH /api/debug-portal/agent/tickets/:idOrTicketId/status  body: { "status": "COMPLETED" }
# Set API_PUBLIC_URL so screenshot.publicUrl is absolute for vision agents.
# API_PUBLIC_URL="https://your-dev-api.up.railway.app"
# DEBUG_PORTAL_PUBLIC_URL="https://debug-web-development.up.railway.app"
