{
  "name": "techbubble-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy:railway": "./scripts/railway-deploy-all.sh",
    "deploy:railway:api": "./scripts/railway-deploy-all.sh api",
    "deploy:railway:web": "./scripts/railway-deploy-all.sh web",
    "deploy:railway:admin": "./scripts/railway-deploy-all.sh admin",
    "deploy:railway:ticketing": "./scripts/railway-deploy-all.sh ticketing",
    "db:migrate": "turbo run db:migrate",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "db:seed:site-content": "pnpm --filter @techbubble/database db:seed:site-content"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8",
    "prettier": "^3.2.5",
    "turbo": "^2.3.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.0.0"
}
